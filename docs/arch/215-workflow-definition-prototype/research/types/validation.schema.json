{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "validation",
  "type": "object",
  "required": ["url", "reason"],
  "additionalProperties": false,
  "properties": {
    "url": { "type": "string", "format": "uri" },
    "reason": { "type": "string", "minLength": 1 },
    "quote": {
      "type": "string",
      "description": "Verbatim passage backing the verdict; absent when unreachable."
    }
  }
}
