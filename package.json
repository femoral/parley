{
  "name": "parley",
  "version": "0.0.0",
  "private": true,
  "description": "Delegate tasks to agent CLIs (Codex, Grok Build) from an orchestrating agent.",
  "type": "module",
  "bin": {
    "parley": "bin/parley.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "src",
    "skills"
  ],
  "scripts": {
    "parley": "node --import tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@useparley/core": "workspace:*",
    "ajv": "^8.20.0",
    "better-sqlite3": "^11.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
