# UI package build output — the daemon serves each from its `parley.ui` marker
# dir. Generated by `vite build`, never committed.
# packages/ui/www is also regenerated on demand for integration tests via
# scripts/vitest-global-setup.ts; packages/dashboard/www is not (build it
# explicitly when needed).
