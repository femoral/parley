{
  "name": "@useparley/cli",
  "version": "0.0.0",
  "description": "The parley command-line interface: commands, arg parsing, spawn/wait UX, and the orchestrator skills it ships.",
  "type": "module",
  "bin": {
    "parley": "bin/parley.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@useparley/core": "workspace:*",
    "@useparley/daemon": "workspace:*",
    "tsx": "^4.19.2"
  }
}
