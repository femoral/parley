{
  "id": "coding-2",
  "version": 1,
  "type": "coding",
  "workspace": "repo",
  "description": "Implement straight from the brief, review in parallel across three vendors, and let the orchestrator decide each rework round.",

  "inputs": {
    "brief": { "type": "text" }
  },

  "outputs": {
    "branch": { "type": "text", "from": "implement.branch" },
    "summary": { "type": "text", "from": "implement.summary" },
    "verdict": { "type": "verdict", "from": "triage.verdict" }
  },

  "types": {
    "verdict": { "enum": ["approve", "changes_requested"] }
  },

  "nodes": [
    {
      "id": "implement",
      "kind": "step",
      "task_type": "coding",
      "profile": "deep",
      "prompt": "prompts/implement.md",
      "retries": 1,
      "in": {
        "brief": { "type": "text", "from": "run.brief" },
        "rework": { "type": "text" }
      },
      "out": {
        "branch": { "type": "text", "max_length": 200 },
        "summary": { "type": "text", "max_length": 4000 }
      }
    },

    {
      "id": "review",
      "kind": "step",
      "task_type": "review",
      "sandbox": "read-only",
      "prompt": "prompts/review.md",
      "slots": {
        "adversarial": {
          "vendor": "codex",
          "model": "gpt-5.1-codex",
          "effort": "high",
          "prompt_append": "prompts/review/adversarial.md"
        },
        "fast-sweep": {
          "vendor": "grok",
          "model": "grok-code-fast-1",
          "prompt_append": "prompts/review/sweep.md"
        },
        "house-style": {
          "profile": "fast",
          "prompt_append": "prompts/review/house-style.md"
        }
      },
      "in": {
        "branch": { "type": "text", "from": "implement.branch" },
        "brief": { "type": "text", "from": "run.brief" }
      },
      "out": {
        "verdict": { "type": "verdict" },
        "notes": { "type": "text", "max_length": 6000 }
      }
    },

    {
      "id": "triage",
      "kind": "step",
      "task_type": "review",
      "profile": "deep",
      "prompt": "prompts/triage.md",
      "in": {
        "verdicts": { "type": "dict<string, verdict>", "from": "review.verdict" },
        "notes": { "type": "dict<string, text>", "from": "review.notes" },
        "brief": { "type": "text", "from": "run.brief" }
      },
      "out": {
        "verdict": { "type": "verdict" },
        "rework_brief": { "type": "text", "max_length": 4000 }
      }
    },

    {
      "id": "rework-or-finish",
      "kind": "gate",
      "question": "Reviewers asked for changes. Send it back to implementation, or finish the run here?",
      "shows": {
        "verdict": { "from": "triage.verdict" },
        "rework_brief": { "from": "triage.rework_brief" },
        "notes": { "from": "review.notes" }
      },
      "on_reject": "finish",
      "loop": {
        "to": "implement",
        "max": 2,
        "with": {
          "rework": "triage.rework_brief"
        }
      }
    }
  ]
}
