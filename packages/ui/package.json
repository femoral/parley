{
  "name": "@useparley/ui",
  "version": "0.0.0",
  "description": "Parley Cove — the parley web cockpit (React + Vite). An optional install: the daemon discovers and serves it (parley.ui marker) when it's present alongside @useparley/cli/@useparley/daemon.",
  "type": "module",
  "parley": {
    "ui": "www"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "www"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@useparley/core": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/im-fell-english": "^5.2.6",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "happy-dom": "^20.10.6",
    "vite": "^8.1.4"
  }
}
