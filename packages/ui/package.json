{
  "name": "@useparley/ui",
  "version": "0.0.0",
  "description": "The parley web UI (React + Vite), served by the daemon when installed. Placeholder until the UI work lands (ticket #51).",
  "private": true,
  "type": "module",
  "parley": {
    "ui": "www"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "www"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@useparley/core": "workspace:*"
  }
}
