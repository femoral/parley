{
  "name": "@useparley/runner",
  "version": "0.0.0",
  "description": "Remote runner for parley: leases tasks from a daemon and executes them on this host (ADR-0012).",
  "type": "module",
  "bin": {
    "parley-runner": "bin/parley-runner.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "bin"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@useparley/core": "workspace:*",
    "@useparley/daemon": "workspace:*"
  },
  "license": "MIT"
}
