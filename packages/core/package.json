{
  "name": "@useparley/core",
  "version": "0.0.4",
  "description": "Shared heart of parley: domain types, model catalog, home-dir resolution, and shared utilities.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/femoral/parley.git",
    "directory": "packages/core"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "browser": {
        "types": "./src/browser.ts",
        "default": "./src/browser.ts"
      },
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./session-state": {
      "types": "./src/session-state.ts",
      "default": "./src/session-state.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "browser": {
          "types": "./dist/browser.d.ts",
          "default": "./dist/browser.js"
        },
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./session-state": {
        "types": "./dist/session-state.d.ts",
        "default": "./dist/session-state.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT"
}
