{
  "name": "@useparley/dashboard",
  "version": "0.0.1",
  "description": "Parley Console — the parley web dashboard (React + Vite). An optional install: the daemon discovers and serves it (parley.ui marker) when it's present alongside @useparley/cli/@useparley/daemon.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/femoral/parley.git",
    "directory": "packages/dashboard"
  },
  "type": "module",
  "parley": {
    "ui": "www"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "www"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "verify": "node --import tsx verify/demos/run-all.mjs",
    "verify:check": "node --import tsx verify/check.mjs",
    "verify:staged": "node --import tsx verify/demos/staged-daemon.mjs",
    "verify:intercept": "node --import tsx verify/demos/intercept-error.mjs",
    "verify:reconnect": "node --import tsx verify/demos/reconnect.mjs",
    "verify:shell": "node --import tsx verify/demos/shell-chrome.mjs",
    "verify:find": "node --import tsx verify/demos/find-honesty.mjs",
    "verify:task": "node --import tsx verify/demos/task-inspector.mjs",
    "verify:fleet": "node --import tsx verify/demos/fleet-board.mjs",
    "verify:metrics": "node --import tsx verify/demos/metrics-board.mjs",
    "verify:run": "node --import tsx verify/demos/run-detail.mjs"
  },
  "dependencies": {
    "@useparley/core": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@testing-library/react": "^16.3.2",
    "axe-core": "^4.11.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "happy-dom": "^20.10.6",
    "playwright-core": "^1.62.0",
    "vite": "^8.1.4"
  },
  "license": "MIT"
}
