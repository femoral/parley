{
  "name": "@useparley/plugin-claude-code",
  "version": "0.0.4",
  "private": false,
  "description": "Claude Code plugin that records deterministic Parley session provenance.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/femoral/parley.git",
    "directory": "packages/plugins/claude-code"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    ".claude-plugin",
    "hooks",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/hook.ts",
      "default": "./src/hook.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/hook.d.ts",
        "default": "./dist/hook.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@useparley/core": "workspace:*"
  },
  "license": "MIT"
}
